# --- Database (MySQL) ---
DB_NAME=app_db
DB_USER=root
DB_PASSWORD=root_password
DB_ROOT_PASSWORD=root_password
DB_HOST=db
DB_PORT=3306

# --- Laravel ---
APP_NAME=ImageCleaner
APP_ENV=local
APP_KEY=  # php artisan key:generate で生成
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Python API ---
# LaravelからPythonを呼ぶためのURL (Docker内通信)
PYTHON_API_URL=http://python-api:8000

# --- Frontend (Vue.js) ---
# ブラウザからLaravelを呼ぶためのURL
VITE_API_BASE_URL=http://localhost:8080/api
